# Copy to .env.local and keep the file private.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
SYNC_API_READ_TOKEN=replace-with-a-random-read-secret
SYNC_API_WRITE_TOKEN=replace-with-a-different-random-write-secret
