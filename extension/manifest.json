{
  "manifest_version": 3,
  "name": "JP Freedom Focus Blocklist",
  "version": "1.0.0",
  "description": "Applies the phone's synced desktop site blocklist during Planned blocks.",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "JP Freedom Focus Blocklist",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js", "styles.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
