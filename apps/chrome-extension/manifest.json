{
  "manifest_version": 3,
  "name": "JP Freedom",
  "version": "1.0.0",
  "description": "Sync focus plans and block selected desktop sites during focus blocks.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms", "declarativeNetRequest"],
  "host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "src/service-worker.js", "type": "module" },
  "action": {},
  "options_ui": { "page": "management.html", "open_in_tab": true },
  "declarative_net_request": {
    "rule_resources": [{ "id": "base", "enabled": true, "path": "rules.json" }]
  },
  "web_accessible_resources": [{
    "resources": ["blocked.html", "management.css"],
    "matches": ["http://*/*", "https://*/*"]
  }]
}
