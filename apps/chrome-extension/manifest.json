{
  "manifest_version": 3,
  "name": "JP Freedom",
  "version": "1.0.0",
  "description": "Sync focus plans and block selected desktop sites during focus blocks.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/app-16.png",
    "48": "icons/app-48.png",
    "128": "icons/app-128.png"
  },
  "permissions": ["storage", "alarms", "notifications", "declarativeNetRequest"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://br-floral-block-bddjl0rs-jpfreedomsync.compute.c-8.us-east-2.aws.neon.tech/*"],
  "background": { "service_worker": "src/service-worker.js", "type": "module" },
  "action": {
    "default_icon": {
      "16": "icons/app-16.png",
      "48": "icons/app-48.png",
      "128": "icons/app-128.png"
    }
  },
  "options_ui": { "page": "management.html", "open_in_tab": true },
  "sandbox": { "pages": ["focus-terrain.html"] },
  "declarative_net_request": {
    "rule_resources": [{ "id": "base", "enabled": true, "path": "rules.json" }]
  }
}
