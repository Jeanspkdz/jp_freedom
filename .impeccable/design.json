      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Full-width filled action for adding a planned block.",
      "html": "<button class=\"ds-button-primary\">Añadir bloque</button>",
      "css": ".ds-button-primary{display:flex;align-items:center;justify-content:center;width:100%;min-height:60px;padding:12px 20px;border:0;border-radius:9999px;background:#A65608;color:#FFFFFF;font:600 22px/1.2 Roboto,Arial,sans-serif;transition:filter .16s ease,opacity .12s ease}.ds-button-primary:hover{filter:brightness(.96)}.ds-button-primary:active{opacity:.88}.ds-button-primary:focus-visible{outline:2px solid #A65608;outline-offset:3px}"
    },
    {
      "name": "Day selector",
