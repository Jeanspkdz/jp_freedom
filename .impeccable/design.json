      "css": ".ds-agenda-row{display:flex;align-items:center;gap:8px;min-height:92px;font:14px Roboto,Arial,sans-serif;color:#0A0A0E}.ds-agenda-row time{width:94px;white-space:nowrap}.ds-agenda-card{display:flex;flex:1;min-height:76px;flex-direction:column;justify-content:center;gap:6px;padding:12px;border:1px solid rgba(166,86,8,.36);border-radius:16px;background:rgba(249,224,180,.64)}.ds-agenda-card strong{font:600 16px Roboto,Arial,sans-serif;color:#0A0A0E}.ds-agenda-card span{font:600 14px Roboto,Arial,sans-serif;color:#FFFFFF;background:#A65608;border-radius:9999px;padding:4px 10px;align-self:flex-start}.ds-agenda-card:hover{filter:brightness(.98)}.ds-agenda-card:active{opacity:.9}.ds-agenda-card:focus-visible{outline:2px solid #A65608;outline-offset:2px}"
