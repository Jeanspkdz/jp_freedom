  "narrative": {
    "northStar": "A live timetable board",
    "overview": "JP Freedom presents the day as a time-ordered board, so the current focus state and the next commitment are easy to scan. Native Material 3 structure keeps planning familiar on Android; a quiet neutral field and a warm amber accent carry the approved direction into planner, editor, and settings screens.",
    "keyCharacteristics": [
      "Time gives the agenda its order.",
      "The current block and its state remain visible in the row.",
      "Warm amber marks active focus and the primary action.",
      "Native Android controls and system text scaling keep the interface familiar and readable."
    ],
    "rules": [
      {
        "name": "The Time-First Rule",
        "body": "Order planned blocks by start time and keep their time labels easy to scan.",
        "section": "layout"
      },
      {
        "name": "The Held-State Rule",
        "body": "Keep the current or completed state visible in the agenda; a transient animation is never the only signal.",
        "section": "components"
      },
      {
        "name": "The Role-First Rule",
        "body": "Use semantic Material color roles so surfaces and content stay paired in both system themes.",
        "section": "colors"
      },
      {
        "name": "The System-Type Rule",
        "body": "Use Material 3 type roles and scalable Android text units instead of assigning one-off sizes or a brand typeface.",
        "section": "typography"
      },
      {
        "name": "The Flat-Board Rule",
        "body": "Separate agenda rows with tonal surfaces and borders rather than decorative shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the time, activity, and state readable together.",
      "Do use the semantic light and dark roles from FocusTheme.",
      "Do pair status color with an explicit text label.",
      "Do follow system font scaling and native Android touch behavior."
    ],
    "donts": [
      "Don't rely on a transient animation as the only signal of a changed or current block.",
      "Don't introduce aviation terms or airport imagery; the selected direction uses schedule ordering only.",
      "Don't add decorative shadows or a competing accent.",
      "Don't replace the approved amber role with dynamic wallpaper color."
    ]
  }
}