      "html": "<article class=\"ds-agenda-row\"><time>09:00–10:00</time><div class=\"ds-agenda-card\"><strong>Bloque de enfoque</strong><span>Siguiente</span></div></article>",
      "css": ".ds-agenda-row{display:flex;align-items:center;gap:8px;min-height:92px;font:14px Roboto,Arial,sans-serif;color:#0A0A0E}.ds-agenda-row time{width:94px;white-space:nowrap}.ds-agenda-card{display:flex;flex:1;min-height:76px;flex-direction:column;justify-content:center;gap:6px;padding:12px;border:1px solid #E3E3E7;border-radius:16px;background:#FFFEFE}.ds-agenda-card strong{font:600 16px Roboto,Arial,sans-serif}.ds-agenda-card span{font:600 14px Roboto,Arial,sans-serif;color:#36363D}.ds-agenda-card:focus-visible{outline:2px solid #A65608;outline-offset:2px}"
    },
