      "description": "Native two-choice segmented control for Hoy and Mañana.",
      "html": "<nav class=\"ds-day-selector\" aria-label=\"Día\"><button class=\"ds-day-option ds-selected\" aria-current=\"page\">Hoy</button><button class=\"ds-day-option\">Mañana</button></nav>",
      "css": ".ds-day-selector{display:flex;width:100%;font:500 16px Roboto,Arial,sans-serif}.ds-day-option{flex:1;min-height:48px;border:1px solid #D4D4DA;background:transparent;color:#0A0A0E;padding:8px 12px}.ds-day-option:first-child{border-radius:16px 0 0 16px}.ds-day-option:last-child{border-radius:0 16px 16px 0}.ds-day-option.ds-selected{background:#E9E9ED;color:#22232A}.ds-day-option:hover{filter:brightness(.97)}.ds-day-option:active{opacity:.88}.ds-day-option:focus-visible{outline:2px solid #A65608;outline-offset:2px;z-index:1}"
    },
